{
  "name": "perfectui-doc",
  "version": "1.0.0",
  "description": "Documentation site of Perfect UI",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run docs:sync && nuxt dev",
    "docs:sync": "bun scripts/sync-docs.ts",
    "generate": "bun run docs:sync && nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck && tsc -p tests/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run && playwright test --project=chromium --project=fixtures --project=quality",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "test:slow": "playwright test --project=slow"
  },
  "dependencies": {
    "@chrissgon/perfectui": "1.0.0-beta.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/fira-code": "5.3.0",
    "@nuxt/content": "3.16.1",
    "minisearch": "7.2.0",
    "nuxt": "4.5.2",
    "vue": "3.5.43",
    "vue-router": "5.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@nuxt/eslint": "1.17.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "chrome-launcher": "1.2.1",
    "eslint": "10.11.0",
    "lighthouse": "13.5.0",
    "shiki": "4.4.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.1",
    "vue-tsc": "3.3.11"
  }
}
